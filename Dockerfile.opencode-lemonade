FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Core toolchain, dependencies, and shell linter
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    sudo \
    vim \
    nano \
    jq \
    net-tools \
    iputils-ping \
    shellcheck \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*


# Install OpenCode CLI and AST tools (remove legacy Ubuntu /usr/bin/sg conflict)
RUN rm -f /usr/bin/sg && npm install -g --force opencode-ai @ast-grep/cli

# Install Python MCP SDK and Ruff linter
RUN pip3 install --no-cache-dir --break-system-packages "mcp[cli]" ruff

# Non-root user setup (remove default ubuntu user so developer gets UID 1000)
RUN touch /var/mail/ubuntu && userdel -r ubuntu 2>/dev/null || true && \
    useradd -u 1000 -m -s /bin/bash developer && \
    echo "developer ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Create the safe test/run execution wrapper (caps output, enforces timeout)
RUN cat << 'EOF' > /usr/local/bin/safe-run
#!/usr/bin/env bash
MAX_LINES=60
TIMEOUT=15s

OUTPUT=$(timeout "$TIMEOUT" "$@" 2>&1)
STATUS=$?

TOTAL_LINES=$(echo "$OUTPUT" | wc -l)

if [ "$TOTAL_LINES" -gt "$MAX_LINES" ]; then
    echo "$OUTPUT" | head -n "$MAX_LINES"
    echo ""
    echo "[!] Output truncated: ($TOTAL_LINES lines total). Displaying first $MAX_LINES lines to protect context budget."
else
    echo "$OUTPUT"
fi

if [ $STATUS -eq 124 ]; then
    echo "[-] Execution timed out after $TIMEOUT."
    exit 124
fi

exit $STATUS
EOF

RUN chmod +x /usr/local/bin/safe-run

# Create the local FastMCP structural search server
RUN cat << 'EOF' > /usr/local/bin/codenav-mcp
#!/usr/bin/env python3
import sys
import subprocess
import json
import ast
from pathlib import Path
from mcp.server.fastmcp import FastMCP

mcp = FastMCP("code-nav")

@mcp.tool()
def code_outline(file_path: str) -> str:
    """Extract classes, methods, and functions with line numbers from a file without dumping bodies. Use this to locate symbols while saving tokens."""
    path = Path(file_path)
    if not path.exists():
        return f"Error: File '{file_path}' not found."
    
    if path.suffix == ".py":
        try:
            tree = ast.parse(path.read_text(encoding="utf-8"))
            lines = []
            for node in ast.iter_child_nodes(tree):
                if isinstance(node, ast.ClassDef):
                    lines.append(f"Line {node.lineno}: class {node.name}")
                    for item in node.body:
                        if isinstance(item, (ast.FunctionDef, ast.AsyncFunctionDef)):
                            args = [a.arg for a in item.args.args]
                            lines.append(f"  Line {item.lineno}: def {item.name}({', '.join(args)})")
                elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    args = [a.arg for a in node.args.args]
                    lines.append(f"Line {node.lineno}: def {node.name}({', '.join(args)})")
            return "\n".join(lines) if lines else "No top-level classes or functions found."
        except Exception as e:
            return f"Error parsing Python AST: {e}"
    
    res = subprocess.run(
        ["ast-grep", "run", "--pattern", "function $NAME($$$)", "--json=compact", str(path)],
        capture_output=True, text=True
    )
    return res.stdout or "No functions found."

@mcp.tool()
def ast_search(pattern: str, language: str = "python", path: str = "/workspace") -> str:
    """Search code structurally using ast-grep patterns (e.g., 'class $A', 'def $B($$$)', '$X.update($$$)')."""
    try:
        cmd = ["ast-grep", "run", "--pattern", pattern, "--lang", language, "--json=compact", path]
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        if not res.stdout.strip():
            return "No matches found."
        matches = json.loads(res.stdout)
        summary = []
        for m in matches[:15]:
            file = m.get("file", "")
            line = m.get("range", {}).get("start", {}).get("line", 0) + 1
            text = m.get("text", "").splitlines()[0]
            summary.append(f"{file}:{line} -> {text}")
        return "\n".join(summary)
    except Exception as e:
        return f"ast-grep error: {e}"

if __name__ == "__main__":
    mcp.run(transport="stdio")
EOF

RUN chmod +x /usr/local/bin/codenav-mcp

# Create the dynamic launcher script
RUN cat << 'EOF' > /usr/local/bin/opencode-select
#!/usr/bin/env bash

LEMONADE_URL="http://host.docker.internal:13305/api/v1"

echo "[*] Querying Lemonade Server at ${LEMONADE_URL}..."
RESPONSE=$(curl -s --connect-timeout 5 "${LEMONADE_URL}/models")

if [ -z "$RESPONSE" ] || ! echo "$RESPONSE" | jq -e '.data' > /dev/null 2>&1; then
    echo "[-] Error: Could not connect to Lemonade Server at ${LEMONADE_URL}"
    echo "    Make sure Lemonade is running and listening on port 13305."
    exit 1
fi

# Filter for LLMs (exclude image/tts generators)
mapfile -t MODELS < <(echo "$RESPONSE" | jq -r '.data[] | select((.labels // []) | (contains(["image"]) or contains(["tts"])) | not) | .id')

if [ ${#MODELS[@]} -eq 0 ]; then
    echo "[-] No compatible text models found in Lemonade."
    exit 1
fi

echo ""
echo "================================================================="
echo "                   Available Lemonade Models                     "
echo "================================================================="
for i in "${!MODELS[@]}"; do
    MODEL_ID="${MODELS[$i]}"
    LABELS=$(echo "$RESPONSE" | jq -r --arg id "$MODEL_ID" '.data[] | select(.id == $id) | (.labels // []) | join(", ")')
    SIZE=$(echo "$RESPONSE" | jq -r --arg id "$MODEL_ID" '.data[] | select(.id == $id) | .size // "N/A"')
    printf " [%d] %-50s (%4s GB) [%s]\n" "$((i+1))" "$MODEL_ID" "$SIZE" "$LABELS"
done
echo "================================================================="
echo ""

while true; do
    read -p "Select a model to load [1-${#MODELS[@]}]: " SELECTION
    if [[ "$SELECTION" =~ ^[0-9]+$ ]] && [ "$SELECTION" -ge 1 ] && [ "$SELECTION" -le "${#MODELS[@]}" ]; then
        SELECTED_MODEL="${MODELS[$((SELECTION-1))]}"
        break
    else
        echo "Invalid selection. Enter a number between 1 and ${#MODELS[@]}."
    fi
done

echo ""
echo "[*] Selected: $SELECTED_MODEL"
echo "[*] Warming up model in Lemonade (allowing up to 300s for cold-load)..."

WARMUP=$(curl -s -X POST "${LEMONADE_URL}/chat/completions" \
    -H "Content-Type: application/json" \
    -d "{\"model\": \"$SELECTED_MODEL\", \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}], \"max_tokens\": 1}" \
    --max-time 300)

if [ $? -ne 0 ]; then
    echo "[-] Error: Model warmup timed out or failed."
    exit 1
fi

# Dynamically generate ~/.config/opencode/opencode.json
mkdir -p "$HOME/.config/opencode"

echo "$RESPONSE" | jq --arg sel "$SELECTED_MODEL" --arg base "$LEMONADE_URL" '{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lemonade": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lemonade Server",
      "options": {
        "baseURL": $base,
        "apiKey": "lemonade",
        "temperature": 0.1,
        "timeout": 3000000,
        "headerTimeout": 600000,
        "chunkTimeout": 3000000
      },
      "models": (
        [.data[] | select((.labels // []) | (contains(["image"]) or contains(["tts"])) | not)]
        | reduce .[] as $m ({}; . + {
            ($m.id): {
              "name": $m.id,
              "limit": {
                "context": 81920,
                "output": 32768
              }
            }
          })
      )
    }
  },
  "model": ("lemonade/" + $sel),
  "mcp": {
    "codenav": {
      "type": "local",
      "command": ["python3", "/usr/local/bin/codenav-mcp"],
      "enabled": true
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  }
}' > "$HOME/.config/opencode/opencode.json"

echo "[+] Configured OpenCode with active model: $SELECTED_MODEL"

# Auto-seed AGENTS.md in the mounted workspace if it does not already exist
if [ ! -f /workspace/AGENTS.md ]; then
    cat << 'AGENTS_EOF' > /workspace/AGENTS.md
# Workspace Directives

## File System & Working Directory
- The workspace root is `/workspace` (current directory `./`).
- All created code, tests, and documents MUST be written inside `/workspace`.
- NEVER create files in `/home/developer` or `~`.

## Token Conservation & Code Navigation
- To inspect code structure, prefer `code_outline` over reading entire files.
- To locate specific function calls, class instantiations, or variable modifications across the codebase, use `ast_search`.
- Only use `read` on targeted, small sections or small files (< 100 lines) after identifying the target location.

## Code Quality, Verification & Safe Execution
- For files exceeding 50 lines that already exist, ALWAYS use targeted edit/patch operations instead of rewriting the entire file.
- Before running execution tests on Python files, check syntax and lint errors via bash: `ruff check <path>`.
- Use `safe-run` for all command and test execution (e.g., `safe-run python3 -m unittest discover -s tests`). NEVER run bare commands that can produce unbounded stdout.
- Never run curses or interactive TUI loops directly in bash. Always test logic through headless unit tests.
- If unsure of a standard library signature or constants (e.g., `curses`, `asyncio`), verify it via bash: `python3 -m pydoc <module.function>` rather than guessing.

## Phase 1: High-Level Design (Planning)
- When requested to design, plan, or architect a system:
  1. Write the complete architectural specification directly to `./PLAN.md` using the file creation tool.
  2. Structure `./PLAN.md` into discrete, numbered, testable milestones.
  3. Keep in-chat summaries concise; let `./PLAN.md` hold the detailed architectural specs.

## Phase 2: Implementation (Building)
- When directed to implement or execute a step from `./PLAN.md`:
  1. DO NOT output conversational status reports or introspective analysis (e.g., "Active", "Blocked", "Next Move").
  2. DO NOT describe planned changes in text before invoking tools.
  3. Your very first action on each turn MUST be an actual tool call (`write`, `edit`, or `bash`).
AGENTS_EOF
    echo "[+] Seeded /workspace/AGENTS.md with operational rules"
fi

# Route internal OpenCode state into the mounted working directory
rm -rf "$HOME/.local/share/opencode"
mkdir -p /workspace/.opencode
mkdir -p "$HOME/.local/share"
ln -sfn /workspace/.opencode "$HOME/.local/share/opencode"

echo "[*] Starting OpenCode..."
echo ""

exec opencode "$@"
EOF

RUN chmod +x /usr/local/bin/opencode-select

USER developer
WORKDIR /workspace

CMD ["/bin/bash"]
