# syntax=docker/dockerfile:1
FROM docker.io/kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    MSF_DISABLE_POSTGRES_MESSAGE=1

# --- Base plumbing. Kali's stock image is minimal; bring the floor up first.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget gnupg sudo \
      git vim nano less procps iproute2 iputils-ping net-tools \
      jq yq ripgrep fd-find bat tree unzip zip file binutils moreutils \
      python3 python3-pip python3-venv python3-dev build-essential \
      golang-go nodejs npm \
      socat netcat-openbsd ncat dnsutils whois tcpdump arp-scan macchanger \
      postgresql postgresql-client sqlite3 \
      seclists wordlists \
    && rm -rf /var/lib/apt/lists/*

# --- External recon + web application surface
RUN apt-get update && apt-get install -y --no-install-recommends \
      nmap masscan nuclei subfinder naabu katana dnsx \
      ffuf feroxbuster gobuster dirb dirsearch wfuzz nikto sqlmap \
      whatweb wafw00f testssl.sh \
      hydra john hashcat \
    && rm -rf /var/lib/apt/lists/*

# --- Exploitation + Active Directory
RUN apt-get update && apt-get install -y --no-install-recommends \
      metasploit-framework \
      netexec python3-impacket impacket-scripts \
      ldap-utils krb5-user smbclient cifs-utils winbind \
      responder mitm6 \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages \
      "mcp[cli]<2" certipy-ad bloodhound ldap3 requests \
    && pip3 cache purge

RUN curl -fsSL https://raw.githubusercontent.com/dirkjanm/krbrelayx/master/dnstool.py -o /usr/local/bin/dnstool.py \
    && chmod +x /usr/local/bin/dnstool.py

# --- Pivoting tooling. GitHub releases, not apt. Failures warn rather than
#     abort the build so a release-API hiccup doesn't kill the image.
RUN set -u; \
    fetch_latest() { \
      repo="$1"; pat="$2"; bin="$3"; \
      url=$(curl -fsSL "https://api.github.com/repos/${repo}/releases/latest" \
            | jq -r ".assets[].browser_download_url | select(test(\"${pat}\"))" \
            | head -n1) || true; \
      if [ -z "${url}" ] || [ "${url}" = "null" ]; then \
        echo "WARN: could not resolve ${repo}; ${bin} skipped"; return 0; \
      fi; \
      curl -fsSL "${url}" -o /tmp/dl.bin; \
      case "${url}" in \
        *.tar.gz) tar -xzf /tmp/dl.bin -C /usr/local/bin "${bin}" ;; \
        *.gz)     gunzip -c /tmp/dl.bin > "/usr/local/bin/${bin}" ;; \
        *)        cp /tmp/dl.bin "/usr/local/bin/${bin}" ;; \
      esac; \
      chmod +x "/usr/local/bin/${bin}"; \
      echo "[+] installed ${bin}"; \
      rm -f /tmp/dl.bin; \
    }; \
    fetch_latest "nicocha30/ligolo-ng" "proxy.*linux_amd64.tar.gz" "proxy"; \
    [ -f /usr/local/bin/proxy ] && mv /usr/local/bin/proxy /usr/local/bin/ligolo-proxy || true; \
    fetch_latest "jpillora/chisel" "linux_amd64.gz" "chisel"; \
    true

# --- OpenCode CLI. Kali ships /usr/bin/sg from shadow, which collides with the
#     npm bin shim -- same conflict the Ubuntu build worked around.
RUN rm -f /usr/bin/sg && npm install -g --force --allow-scripts=opencode-ai opencode-ai

# --- Agent Setup
# Passes heredocs to Bash to bypass Podman 4.x parser limitations, then cleans up.
COPY setup-openCode-halogen-hacker.sh /tmp/setup-openCode-halogen-hacker.sh
RUN bash /tmp/setup-openCode-halogen-hacker.sh && rm -f /tmp/setup-openCode-halogen-hacker.sh